# QuantAlgo PropFirms — example environment configuration.
# Copy to `.env` and fill in. Every value is optional; defaults work out of the box.

# Default trading symbol: MES | ES | NQ | YM
QA_SYMBOL=MES

# Starting account balance used by the backtester / simulator.
QA_INITIAL_CAPITAL=50000

# --- Tradovate / Topstep credentials (only needed for paper/live execution) ---
QA_TRADOVATE_USERNAME=
QA_TRADOVATE_PASSWORD=
QA_TRADOVATE_API_KEY=
QA_TRADOVATE_ORG=
# true = demo/paper account, false = live (live also requires real OAuth2 setup)
QA_TRADOVATE_SANDBOX=true
